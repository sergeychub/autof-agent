<Window x:Class="WorkstationAgent.Forms.SetupWizardForm" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="AutoF Agent — рабочее место" Width="1060" Height="780" MinWidth="820" MinHeight="570"
        WindowStartupLocation="CenterScreen" Style="{DynamicResource MaterialDesignWindow}"
        Background="#F5F3EE" Foreground="#202226" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <md:BundledTheme BaseTheme="Light" PrimaryColor="Indigo" SecondaryColor="Pink" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PrimaryInk" Color="#3F51B5" />
            <SolidColorBrush x:Key="MutedInk" Color="#5E605D" />
            <SolidColorBrush x:Key="SurfaceLine" Color="#E9E5DD" />
            <SolidColorBrush x:Key="FieldOutline" Color="#B7B5B0" />

            <Style x:Key="PanelCard" TargetType="Border">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource SurfaceLine}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Padding" Value="22,19" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>

            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="19" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SupportingText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedInk}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Margin" Value="0,5,0,0" />
            </Style>

            <Style x:Key="InputField" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="BorderBrush" Value="{StaticResource FieldOutline}" />
            </Style>

            <Style x:Key="SelectField" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="BorderBrush" Value="{StaticResource FieldOutline}" />
            </Style>

            <Style x:Key="NavEntry" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="#494944" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Padding" Value="14,9" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="MinHeight" Value="42" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Highlight" BorderThickness="1" BorderBrush="Transparent"
                                    Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <md:PackIcon Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="19" Height="19" VerticalAlignment="Center" />
                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F3F1EC" /></Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E9EBFA" />
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryInk}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Highlight" Property="BorderBrush" Value="{StaticResource PrimaryInk}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="Workspace" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}">
        <Grid.RowDefinitions><RowDefinition Height="62" /><RowDefinition Height="*" /><RowDefinition Height="64" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="234" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" Background="White" BorderBrush="{StaticResource SurfaceLine}" BorderThickness="0,0,0,1" Padding="22,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="BrandLogo" Width="36" Height="33" Margin="0,0,12,0" />
                    <TextBlock Text="AutoF Agent" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Border x:Name="ConnectionBadge" DockPanel.Dock="Right" CornerRadius="18" Padding="12,7" VerticalAlignment="Center" Background="#F2EBD9">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#8A641F" Margin="0,0,8,0" />
                        <TextBlock x:Name="ConnectionText" FontWeight="Medium" FontSize="13" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="#FFFDFA" BorderBrush="{StaticResource SurfaceLine}" BorderThickness="0,0,1,0" Padding="16,18,16,14">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource SurfaceLine}" BorderThickness="0,1,0,0" Padding="10,12,10,0">
                    <StackPanel>
                        <TextBlock x:Name="SidebarName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource SupportingText}" FontSize="12" />
                    </StackPanel>
                </Border>
                <ListBox x:Name="Navigation" BorderThickness="0" Padding="0" Background="Transparent"
                         AutomationProperties.Name="Разделы настроек" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource NavEntry}" SelectionChanged="SelectPage">
                    <ListBoxItem Tag="ViewDashboardOutline">Обзор</ListBoxItem>
                    <ListBoxItem Tag="LinkVariant">Подключение</ListBoxItem>
                    <ListBoxItem Tag="ReceiptTextOutline">Чековый принтер</ListBoxItem>
                    <ListBoxItem Tag="TagOutline">Принтер этикеток</ListBoxItem>
                    <ListBoxItem Tag="CreditCardOutline">Платёжный терминал</ListBoxItem>
                    <ListBoxItem Tag="TextBoxOutline">Журнал агента</ListBoxItem>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" Grid.Column="1" Style="{StaticResource MaterialDesignScrollViewer}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="26,22,26,10" MaxWidth="1040">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Style="{StaticResource PanelCard}" Background="#FFFDFA" Padding="22,18" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="51" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="40" Height="40" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#EAEAF9" CornerRadius="12">
                            <md:PackIcon x:Name="PageIcon" Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource PrimaryInk}" />
                        </Border>
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="PageTitle" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="PageDescription" Style="{StaticResource SupportingText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <StackPanel x:Name="OverviewPage">
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <TextBlock Text="Связь с CRM" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="OverviewEndpoint" Style="{StaticResource SupportingText}" />
                                <Button Content="Настройки подключения" Style="{StaticResource MaterialDesignOutlinedButton}"
                                        HorizontalAlignment="Left" Margin="0,15,0,0" Tag="1" Click="OpenPage" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <TextBlock Text="Оборудование" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                                <Button Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left" Tag="2" Click="OpenPage">
                                    <TextBlock x:Name="OverviewReceipt" />
                                </Button>
                                <Button Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left" Tag="3" Click="OpenPage">
                                    <TextBlock x:Name="OverviewLabel" />
                                </Button>
                                <Button Style="{StaticResource MaterialDesignFlatButton}" HorizontalContentAlignment="Left" Tag="4" Click="OpenPage">
                                    <TextBlock x:Name="OverviewTerminal" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ConnectionPage" Visibility="Collapsed">
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <TextBlock Text="Настройки сервера" Style="{StaticResource CardTitle}" />
                                <TextBox x:Name="ApiBaseUrl" Style="{StaticResource InputField}" md:HintAssist.Hint="Адрес API" Margin="0,17,0,13" />
                                <PasswordBox x:Name="RegistrationToken" Style="{StaticResource MaterialDesignOutlinedPasswordBox}" md:HintAssist.Hint="Токен регистрации" MinHeight="48"
                                             BorderBrush="{StaticResource FieldOutline}" />
                                <TextBlock x:Name="TokenHint" Style="{StaticResource SupportingText}" Margin="0,9,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <TextBlock Text="Рабочее место" Style="{StaticResource CardTitle}" />
                                <TextBox x:Name="AgentNameField" Style="{StaticResource InputField}" md:HintAssist.Hint="Имя в CRM" Margin="0,17,0,0" TextChanged="RefreshOverview" />
                                <TextBlock x:Name="DeviceIdText" Style="{StaticResource SupportingText}" Margin="0,9,0,13" />
                                <DockPanel LastChildFill="True">
                                    <ToggleButton x:Name="StartWithWindows" DockPanel.Dock="Right" Margin="10,0,0,0" Style="{StaticResource MaterialDesignSwitchToggleButton}" AutomationProperties.Name="Запускать вместе с Windows" />
                                    <TextBlock Text="Запускать вместе с Windows" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="ReceiptPage" Visibility="Collapsed">
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <ToggleButton x:Name="ReceiptEnabled" DockPanel.Dock="Right" Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  Checked="RefreshOverview" Unchecked="RefreshOverview" AutomationProperties.Name="Использовать чековый принтер" />
                                    <StackPanel>
                                        <TextBlock Text="Параметры печати" Style="{StaticResource CardTitle}" />
                                        <TextBlock x:Name="ReceiptStatus" Style="{StaticResource SupportingText}" />
                                    </StackPanel>
                                </DockPanel>
                                <UniformGrid Columns="2" Margin="0,18,0,0">
                                    <ComboBox x:Name="ReceiptTransport" Style="{StaticResource SelectField}" md:HintAssist.Hint="Подключение" Margin="0,0,8,0" SelectionChanged="RefreshTransport" />
                                    <ComboBox x:Name="ReceiptImageMode" Style="{StaticResource SelectField}" md:HintAssist.Hint="Команда изображения" Margin="8,0,0,0" />
                                </UniformGrid>
                                <ComboBox x:Name="ReceiptWindowsPrinter" Style="{StaticResource SelectField}" md:HintAssist.Hint="Принтер Windows" Margin="0,14,0,0" />
                                <UniformGrid x:Name="ReceiptUsbFields" Columns="2" Margin="0,14,0,0" Visibility="Collapsed">
                                    <TextBox x:Name="ReceiptVid" Style="{StaticResource InputField}" md:HintAssist.Hint="USB VID" Margin="0,0,8,0" />
                                    <TextBox x:Name="ReceiptPid" Style="{StaticResource InputField}" md:HintAssist.Hint="USB PID" Margin="8,0,0,0" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelCard}">
                            <DockPanel LastChildFill="True">
                                <ToggleButton x:Name="DrawerHotkey" DockPanel.Dock="Right" Margin="14,0,0,0" Style="{StaticResource MaterialDesignSwitchToggleButton}" AutomationProperties.Name="Открывать денежный ящик по F8" />
                                <StackPanel>
                                    <TextBlock Text="Денежный ящик" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Открывать через чековый принтер по клавише F8." Style="{StaticResource SupportingText}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <TextBlock Text="Пробная печать" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="ReceiptTestHint" Style="{StaticResource SupportingText}" />
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Content="Пробный чек" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,4"
                                            IsEnabled="{Binding IsChecked, ElementName=ReceiptEnabled}" Click="TestReceipt" />
                                    <Button Content="Печать логотипа" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,0,4"
                                            IsEnabled="{Binding IsChecked, ElementName=ReceiptEnabled}" Click="TestReceiptLogo" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="LabelPage" Visibility="Collapsed">
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <ToggleButton x:Name="LabelEnabled" DockPanel.Dock="Right" Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  Checked="RefreshOverview" Unchecked="RefreshOverview" AutomationProperties.Name="Использовать принтер этикеток" />
                                    <TextBlock Text="Подключение TSPL" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ComboBox x:Name="LabelTransport" Style="{StaticResource SelectField}" md:HintAssist.Hint="Подключение" Margin="0,17,0,0" SelectionChanged="RefreshTransport" />
                                <ComboBox x:Name="LabelWindowsPrinter" Style="{StaticResource SelectField}" md:HintAssist.Hint="Принтер Windows" Margin="0,14,0,0" />
                                <UniformGrid x:Name="LabelUsbFields" Columns="2" Margin="0,14,0,0" Visibility="Collapsed">
                                    <TextBox x:Name="LabelVid" Style="{StaticResource InputField}" md:HintAssist.Hint="USB VID" Margin="0,0,8,0" />
                                    <TextBox x:Name="LabelPid" Style="{StaticResource InputField}" md:HintAssist.Hint="USB PID" Margin="8,0,0,0" />
                                </UniformGrid>
                                <UniformGrid Columns="2" Margin="0,14,0,0">
                                    <TextBox x:Name="LabelEncoding" Style="{StaticResource InputField}" md:HintAssist.Hint="Кодировка" Margin="0,0,8,0" />
                                    <TextBox x:Name="LabelCodePage" Style="{StaticResource InputField}" md:HintAssist.Hint="Кодовая страница" Margin="8,0,0,0" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <TextBlock Text="Формат этикетки" Style="{StaticResource CardTitle}" />
                                <UniformGrid Columns="2" Margin="0,17,0,0">
                                    <TextBox x:Name="LabelWidth" Style="{StaticResource InputField}" md:HintAssist.Hint="Ширина, мм" Margin="0,0,8,0" />
                                    <TextBox x:Name="LabelHeight" Style="{StaticResource InputField}" md:HintAssist.Hint="Высота, мм" Margin="8,0,0,0" />
                                    <TextBox x:Name="LabelGap" Style="{StaticResource InputField}" md:HintAssist.Hint="Зазор, мм" Margin="0,14,8,0" />
                                    <ComboBox x:Name="LabelDirection" Style="{StaticResource SelectField}" md:HintAssist.Hint="Направление" Margin="8,14,0,0" />
                                    <TextBox x:Name="LabelSpeed" Style="{StaticResource InputField}" md:HintAssist.Hint="Скорость (1–5)" Margin="0,14,8,0" />
                                    <TextBox x:Name="LabelDensity" Style="{StaticResource InputField}" md:HintAssist.Hint="Плотность (1–15)" Margin="8,14,0,0" />
                                </UniformGrid>
                                <Button Content="Пробная этикетка" Style="{StaticResource MaterialDesignOutlinedButton}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                        IsEnabled="{Binding IsChecked, ElementName=LabelEnabled}" Click="TestLabel" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="TerminalPage" Visibility="Collapsed">
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <ToggleButton x:Name="TerminalEnabled" DockPanel.Dock="Right" Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  Checked="RefreshOverview" Unchecked="RefreshOverview" AutomationProperties.Name="Использовать платёжный терминал" />
                                    <TextBlock Text="Терминал ПриватБанка" Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
                                </DockPanel>
                                <UniformGrid Columns="2" Margin="0,17,0,0">
                                    <TextBox x:Name="TerminalHost" Style="{StaticResource InputField}" md:HintAssist.Hint="IP-адрес или имя хоста" Margin="0,0,8,0" />
                                    <TextBox x:Name="TerminalPort" Style="{StaticResource InputField}" md:HintAssist.Hint="Порт" Margin="8,0,0,0" />
                                    <TextBox x:Name="TerminalMerchant" Style="{StaticResource InputField}" md:HintAssist.Hint="ID продавца" Margin="0,14,8,0" />
                                    <TextBox x:Name="TerminalTimeout" Style="{StaticResource InputField}" md:HintAssist.Hint="Тайм-аут, сек." Margin="8,14,0,0" />
                                </UniformGrid>
                                <Button Content="Проверить связь" Style="{StaticResource MaterialDesignOutlinedButton}" HorizontalAlignment="Left" Margin="0,14,0,0"
                                        IsEnabled="{Binding IsChecked, ElementName=TerminalEnabled}" Click="TestTerminal" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel x:Name="JournalPage" Visibility="Collapsed">
                        <Border Style="{StaticResource PanelCard}">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,14">
                                    <Button Content="Обновить" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,4" Click="RefreshJournal" />
                                    <Button Content="Открыть папку" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,0,4" Click="OpenJournalFolder" />
                                </WrapPanel>
                                <TextBox x:Name="JournalOutput" Style="{StaticResource MaterialDesignOutlinedTextBox}" FontFamily="Consolas" FontSize="12"
                                         AutomationProperties.Name="Последние записи агента" Height="360" IsReadOnly="True" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" AcceptsReturn="True" SpellCheck.IsEnabled="False" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="White" BorderBrush="{StaticResource SurfaceLine}" BorderThickness="0,1,0,0" Padding="22,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Button x:Name="CancelSettings" Content="Отмена" Style="{StaticResource MaterialDesignFlatButton}" Click="Cancel" Margin="0,0,8,0" />
                    <Button x:Name="SaveSettings" Content="Сохранить" Style="{StaticResource MaterialDesignRaisedButton}" Click="Save" />
                </StackPanel>
                <TextBlock x:Name="FooterStatus" Foreground="{StaticResource MutedInk}" VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
